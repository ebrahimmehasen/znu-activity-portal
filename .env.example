# Postgres connection string (Supabase → Project Settings → Database → Connection string).
# Use the "Session pooler" URI (port 5432), locally and on Vercel. The "Transaction pooler"
# (6543) hangs on the pipelined queries the Postgres client sends.
# Leave empty for local development: an embedded PGlite database is used in ./.pglite
DATABASE_URL=

# Super admin created by `npm run db:seed` (change the password after first login).
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=السوبر أدمن

# Encrypts attendance QR secrets at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QR_ENCRYPTION_KEY=
